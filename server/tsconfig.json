{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@sanity/client": [
        "./node_modules/@sanity/client/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../src/lib/sanity/**/*.ts",
    "../src/types.ts"
  ]
}
