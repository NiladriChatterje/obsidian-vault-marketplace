{
  "expo": {
    "name": "Vault Market",
    "slug": "vaultmarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vaultmarket",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0E17",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaultmarket.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vaultmarket.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F0E17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to pick a cover image for your vault listing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
