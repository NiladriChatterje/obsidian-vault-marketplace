# Copy to .env and fill in. Shared by the Expo app, the Next.js site (web/) and the Fastify payment server (server/).
# Leave the Supabase keys empty to run app + site in demo mode (sample vaults, fake auth, local purchases).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Platform commission on paid sales, in percent. Must match PLATFORM_FEE_PERCENT read by the server.
EXPO_PUBLIC_PLATFORM_FEE_PERCENT=10
# The fixed half of the commission, in minor units. It exists to cancel the provider's own
# flat fee: a percentage-only commission always loses money below some price, because the
# percentage shrinks with the price and the provider's flat charge does not.
EXPO_PUBLIC_PLATFORM_FEE_FIXED_CENTS=4000
# What the provider takes. Dodo is 4% + $0.40; the fixed part is in the listing currency
# with a little headroom over the exchange rate. Keep the commission's two halves at or
# above these or the platform loses money on a sale.
EXPO_PUBLIC_PROVIDER_PERCENT_FEE=4
EXPO_PUBLIC_PROVIDER_FIXED_FEE_CENTS=3500
# Cheapest paid listing. A product choice, not a solvency one: the commission is profitable
# at any price, but at a very low one the flat part is most of the sale.
MIN_PRICE_CENTS=19900

# Payment server (server/). The app and site call it for orders and payout onboarding.
SERVER_API_URL=http://localhost:4000
# Same URL for the Expo app: Metro inlines only EXPO_PUBLIC_* names into the bundle.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Port for server/. Hosts that inject PORT (Render, Fly, Railway) are used when this is unset.
API_PORT=4000
# Keep-warm ping for free tiers that idle a service out. Target defaults to RENDER_EXTERNAL_URL,
# then SERVER_API_URL; skipped automatically when that is localhost. Off on paid instances.
# KEEP_AWAKE=off
# KEEP_AWAKE_MINUTES=14
# KEEP_AWAKE_URL=
# Public origin of the website. Optional in the browser (defaults to location.origin); required for app buyers.
# EXPO_PUBLIC_REDIRECT_ORIGIN=https://vault.market
# Comma-separated origins allowed as post-checkout redirect targets. Leave empty to allow any http(s) origin.
# ALLOWED_REDIRECT_ORIGINS=https://vault.market,http://localhost:3000

# Server-only Supabase key: lets the payment server record purchases and resolve MCP tokens.
# Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Without the two keys above the server runs in demo mode, which trusts an x-demo-user header
# and grants every caller ownership of every vault. A hosted instance refuses to start in that
# state; set this to yes only for a deliberately public demo with no real listings.
# ALLOW_PUBLIC_DEMO=yes

# Brevo transactional email (app.brevo.com -> SMTP & API -> API Keys). Leave empty and the
# server sends no mail. BREVO_EMAIL_FROM must be a sender Brevo has verified.
BREVO_API_KEY=
BREVO_EMAIL_FROM=obsidian.vault.marketplace@gmail.com
BREVO_EMAIL_FROM_NAME=Vault Market

# Sanity (vault listings + note contents). Read/written only by server/; make the dataset private.
SANITY_PROJECT_ID=8775uk5l
SANITY_DATASET=production
# Deployed studio application id, printed by `sanity deploy`. Without it the CLI asks which app to deploy to.
SANITY_APPID=
# Editor token from sanity.io/manage -> API -> Tokens. Required for uploads/listings and for reading a private dataset.
SANITY_API_TOKEN=
# sanity = listings come from Sanity via the server (default when SERVER_API_URL is set); local = built-in demo data.
EXPO_PUBLIC_CATALOG_SOURCE=sanity

# --- Dodo Payments (merchant of record; the global rail) ---------------------
# Dodo is the legal seller to the buyer: it takes payment worldwide, remits VAT and
# sales tax, and settles the net to your bank. Dashboard -> Developer -> API Keys.
DODO_API_KEY=
# Dashboard -> Developer -> Webhooks. Point it at https://<api-domain>/webhooks/dodo and
# subscribe to payment.succeeded, payment.failed and refund.succeeded.
DODO_WEBHOOK_SECRET=
# 'live' uses live.dodopayments.com; anything else stays on the test host.
DODO_ENVIRONMENT=test

# Supabase user ids allowed to reach /admin/* (the seller payout ledger). Comma-separated.
# Unset closes those routes entirely rather than leaving them open.
ADMIN_USER_IDS=

# --- Paying sellers ------------------------------------------------------------
# A transfer fee is a fixed cost per payout, so a balance is held until the sales behind
# it have earned enough commission to cover sending it. Thresholds are derived from these,
# per seller, from how they asked to be paid. Amounts in the listing currency's minor units.
PLATFORM_COUNTRY=IN
TRANSFER_COST_BANK_DOMESTIC=500
TRANSFER_COST_BANK_INTERNATIONAL=150000
TRANSFER_COST_WISE=20000
TRANSFER_COST_PAYONEER=20000
TRANSFER_COST_PAYPAL=15000
# Headroom over break-even, and a floor so payouts stay worth processing.
PAYOUT_SAFETY_FACTOR=1.35
PAYOUT_MIN_CENTS=50000
