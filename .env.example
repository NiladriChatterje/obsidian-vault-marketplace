# Copy to .env and fill in. Leave empty to run the app in demo mode (no backend).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Platform commission on paid sales, in percent. Must match PLATFORM_FEE_PERCENT in supabase/functions.
EXPO_PUBLIC_PLATFORM_FEE_PERCENT=15
# --- Next.js site (web/) reads this same file ---
# Public origin of the website, used for Stripe redirects. Optional in the browser (defaults to location.origin).
# EXPO_PUBLIC_REDIRECT_ORIGIN=https://vault.market
# Server-only: lets web/app/api/mcp resolve tokens and stream vault zips. Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
